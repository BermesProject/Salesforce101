    <description>Draft classroom flow for inspecting how an overdue consulting inquiry routes to either a self reminder or a manager escalation while avoiding duplicate open tasks. Students view the structure only; the instructor owns debug and behavior testing.</description>
    <formulas>
        <name>Days_Overdue</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!$Record.Next_Contact_Date__c}), 0, TODAY() - {!$Record.Next_Contact_Date__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>Is_Manager_Escalation</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Record.Manager_Attention__c}, TEXT({!$Record.Inquiry_Status__c}) &lt;&gt; "종료", OR(TEXT({!$Record.Priority__c}) = "높음", {!Days_Overdue} &gt;= 3))</expression>
    </formulas>
    <formulas>
        <name>Is_Self_Reminder</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!$Record.Next_Contact_Date__c})), {!$Record.Next_Contact_Date__c} &lt; TODAY(), TEXT({!$Record.Inquiry_Status__c}) &lt;&gt; "종료")</expression>
    </formulas>
